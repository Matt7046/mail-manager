# Stesso cluster Atlas di Activity Manager (X509)
MONGO_URL=mongodb+srv://cluster0.vmbf6.mongodb.net/?authSource=%24external&authMechanism=MONGODB-X509&tls=true

DB_NAME=mail_manager

# Certificati in ./certificate/ (client.pem + client-key.pem) — copia da Password Manager
MONGO_CERT_PATH=/app/certificate/client.pem
MONGO_KEY_PATH=/app/certificate/client-key.pem

SERVER_SECRET=change-me-long-random

CORS_ORIGINS=https://mail.colorsdev.tech,http://localhost:8081

# --- OAuth Google (Gmail IMAP/SMTP XOAUTH2) ---
# 1) https://console.cloud.google.com/ → APIs & Services → Credentials → OAuth client ID (Web)
# 2) Authorized redirect URI esatta:
#    https://mail.colorsdev.tech/oauth/google/callback
# 3) Abilita Gmail API; scope usati: openid email profile https://mail.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://mail.colorsdev.tech/oauth/google/callback

# --- OAuth Microsoft (Outlook IMAP/SMTP XOAUTH2) ---
# 1) https://portal.azure.com/ → App registrations → New registration
#    - Supported accounts: Personal + work/school (or any)
# 2) Authentication → Add platform Web → Redirect URI:
#    https://mail.colorsdev.tech/oauth/microsoft/callback
# 3) Certificates & secrets → New client secret
# 4) API permissions (delegated):
#    - offline_access, openid, email, profile
#    - IMAP.AccessAsUser.All (Office 365 Exchange Online)
#    - SMTP.Send (Office 365 Exchange Online)
#    Grant admin consent if required for org tenants
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://mail.colorsdev.tech/oauth/microsoft/callback

SYNC_INTERVAL_SECONDS=120
# Poll leggero INBOX per push rapide (secondi). Full sync resta su SYNC_INTERVAL.
NOTIFY_POLL_SECONDS=5
# Web Push (opzionale: se vuoti, le chiavi VAPID vengono generate e salvate in Mongo)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:mail@colorsdev.tech

COMPOSE_NETWORK=backend_app-network
